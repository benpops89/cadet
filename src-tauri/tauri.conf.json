{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadet",
  "version": "0.1.0",
  "identifier": "com.cadet.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cadet",
        "width": 800,
        "height": 600,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "python/__pycache__",
      "bin/ty"
    ],
    "linux": {
      "deb": {
        "postInstallScript": "./debian/post_install.sh",
        "postRemoveScript": "./debian/post_remove.sh",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "python3",
          "python3-venv",
          "python3-pip"
        ]
      }
    }
  }
}
